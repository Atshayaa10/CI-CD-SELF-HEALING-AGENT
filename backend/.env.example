# --- Copy to `.env` and fill in. Never commit the real .env ---

# Groq LPU API key (https://console.groq.com/keys) — powers the LLM agents
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GitHub login ---
# Preferred: "Login with GitHub" OAuth. Register an OAuth App at
# https://github.com/settings/developers  (New OAuth App), then:
#   Homepage URL:               http://localhost:8000
#   Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# Public base URL of THIS app (used to build the OAuth callback). No trailing slash.
APP_BASE_URL=http://localhost:8000
# Override only if your callback differs from {APP_BASE_URL}/auth/github/callback
# OAUTH_REDIRECT_URI=
# Set to "true" when served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Fallback for local/dev or CI-only use (no OAuth): a Personal Access Token with
# `repo` + `workflow` scopes. If OAuth is configured, the logged-in user's token wins.
GITHUB_TOKEN=

# --- GitLab login (optional) ---
# Register an OAuth application at https://gitlab.com/-/profile/applications
#   Redirect URI: http://localhost:8000/auth/gitlab/callback
#   Scopes: api
GITLAB_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# GITLAB_REDIRECT_URI=            # defaults to {APP_BASE_URL}/auth/gitlab/callback
# GITLAB_TOKEN=                   # optional PAT fallback for local/dev

# --- Continuous Deployment ---
# Agent-as-deployer: after a verified merge, the agent runs the healed app on THIS
# machine and exposes it through ngrok. Start ONE tunnel once:
#     ngrok http 5000 --domain=<your-permanent-domain>
DEPLOY_ENABLED=true
DEPLOY_PORT=5000
# Optional: override how the app starts (use {port}); default runs `python app.py`.
# DEPLOY_START_CMD=python app.py
# ngrok's local API — the agent reads the public URL from here automatically.
NGROK_API=http://127.0.0.1:4040/api/tunnels

# Fallback deploy hook (Render/Vercel/etc.) hit after a successful merge.
# Prefer the GitHub Actions deploy.yml pipeline instead (see .github/workflows/deploy.yml).
DEPLOYMENT_WEBHOOK=

# How long (seconds) to wait for the fix branch's CI checks to go green
# before the agent is allowed to merge. Set 0 to merge without waiting (not recommended).
CI_GATE_TIMEOUT=600

# Auto-install ci.yml + deploy.yml into any healed repo that lacks them (part of the fix PR),
# so repos become self-deploying with no manual setup. Set "false" to disable.
AUTO_INSTALL_CICD=true

# --- Verifier sandbox ---
# "docker" runs the patch inside a container (safer, matches "containerized" claim);
# "host" runs pytest in a temp dir on this machine (fallback for machines without Docker).
SANDBOX_MODE=docker
SANDBOX_IMAGE=python:3.11-slim

# Server port
PORT=8000
